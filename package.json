{
  "name": "nightcap",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nightcap/web dev",
    "build": "pnpm --filter @nightcap/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "test:db": "supabase/tests/run.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
