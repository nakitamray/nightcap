# copy to .env.local and fill in from the supabase dashboard
# (project settings -> api keys). the publishable key is safe in the browser;
# never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# optional: the record player in your room. make an app at
# developer.spotify.com/dashboard and add http://127.0.0.1:3000/api/spotify/callback
# (and your real domain later) as a redirect uri. server only, no NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
